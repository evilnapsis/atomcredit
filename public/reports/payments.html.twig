{% extends "layouts/main.html.twig" %}

{% set active_menu = 'reports_payments' %}

{% block title %}Reporte de Pagos - AtomCredit{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <h1 class="h3 fw-bold text-indigo-900 mb-0">Reporte de Pagos y Recaudación</h1>
            <p class="text-muted small mb-0">Consulte los abonos, cuotas y pagos liquidados por los prestatarios en el período indicado.</p>
        </div>
        <div>
            <a href="{{ base_url }}/reports/payments/pdf?start_date={{ start_date }}&end_date={{ end_date }}&payment_method_id={{ payment_method_id }}" target="_blank" class="btn btn-danger shadow-sm fw-bold px-3">
                <i class="bi bi-file-earmark-pdf me-1"></i> Descargar PDF
            </a>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm p-4 mb-4">
    <form method="get" action="{{ base_url }}/reports/payments" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-bold">Fecha Inicial</label>
            <input type="date" name="start_date" class="form-control" value="{{ start_date }}" required>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold">Fecha Final</label>
            <input type="date" name="end_date" class="form-control" value="{{ end_date }}" required>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold">Método de Pago</label>
            <select name="payment_method_id" class="form-select">
                <option value="0">-- Todos los métodos --</option>
                {% for pm in payment_methods %}
                <option value="{{ pm.id }}" {{ payment_method_id == pm.id ? 'selected' : '' }}>
                    {{ pm.name }}
                </option>
                {% endfor %}
            </select>
        </div>
        <div class="col-12 d-flex justify-content-end gap-2 pt-2">
            <a href="{{ base_url }}/reports/payments" class="btn btn-light fw-bold">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar
            </a>
            <button type="submit" class="btn btn-indigo text-white fw-bold px-4">
                <i class="bi bi-funnel me-1"></i> Filtrar Pagos
            </button>
        </div>
    </form>
</div>

<!-- Tarjetas de Resumen -->
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm p-3 bg-white text-center">
            <span class="text-muted small fw-bold d-block">PAGOS REGISTRADOS</span>
            <h3 class="fw-bold text-indigo-900 mb-0 mt-1">{{ payments|length }}</h3>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm p-3 bg-white text-center">
            <span class="text-muted small fw-bold d-block">TOTAL RECAUDADO</span>
            <h3 class="fw-bold text-emerald-700 mb-0 mt-1">{{ currency }}{{ total_paid|number_format(2) }}</h3>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card border-0 shadow-sm p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle datatable mb-0">
            <thead class="table-light">
                <tr class="small text-muted text-uppercase">
                    <th style="width: 70px;"># Pago</th>
                    <th>Fecha y Hora</th>
                    <th>Préstamo</th>
                    <th>Cliente</th>
                    <th>Método de Pago</th>
                    <th class="text-end">Monto Pagado</th>
                    <th>Notas</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody class="small">
                {% for p in payments %}
                <tr>
                    <td class="fw-bold text-indigo-700">#{{ p.id }}</td>
                    <td class="text-muted">{{ p.created_at|date('d/m/Y H:i') }}</td>
                    <td>
                        <a href="{{ base_url }}/loans/{{ p.loan_id }}" class="fw-bold text-decoration-none">
                            Préstamo #{{ p.loan_id }}
                        </a>
                    </td>
                    <td>
                        <div class="fw-bold">{{ p.client_name }} {{ p.client_lastname }}</div>
                        <div class="text-muted small">{{ p.client_document }}</div>
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border">
                            {{ p.payment_method_name ?: 'Efectivo' }}
                        </span>
                    </td>
                    <td class="text-end fw-bold text-emerald-700 fs-6">
                        {{ currency }}{{ p.amount|number_format(2) }}
                    </td>
                    <td class="text-muted small">{{ p.notes ?: '-' }}</td>
                    <td class="text-end pe-3">
                        <a href="{{ base_url }}/loans/{{ p.loan_id }}" class="btn btn-light btn-sm text-primary" title="Ver Préstamo"><i class="bi bi-eye"></i></a>
                        <a href="{{ base_url }}/loans/{{ p.loan_id }}/pdf" target="_blank" class="btn btn-light btn-sm text-danger" title="Ver Cronograma PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
