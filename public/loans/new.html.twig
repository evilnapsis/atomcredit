{% extends "layouts/main.html.twig" %}

{% set active_menu = 'loans' %}

{% block title %}Nuevo Crédito - AtomCredit{% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-12 d-flex align-items-center justify-content-between">
        <div>
            <a href="{{ base_url }}/loans" class="btn btn-light btn-sm fw-bold mb-2">
                <i class="bi bi-arrow-left me-1"></i> Volver a Préstamos
            </a>
            <h1 class="h3 fw-bold text-indigo-900 mb-0">Originación de Nuevo Crédito</h1>
            <p class="text-muted small mb-0">Configure los términos financieros y visualice en tiempo real la agenda simulada de cuotas.</p>
        </div>
        <div>
            <span class="badge bg-indigo-100 text-indigo-700 px-3 py-2 rounded-pill fs-6">
                <i class="bi bi-calculator me-1"></i> Simulador Activo
            </span>
        </div>
    </div>
</div>

<form id="loan-origination-form" method="post" action="{{ base_url }}/loans/create">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">

    <div class="row g-4">
        <!-- Columna Izquierda: Parámetros del Crédito -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold text-indigo-900 mb-3 pb-2 border-bottom d-flex align-items-center">
                    <i class="bi bi-person-badge text-indigo-600 me-2"></i> Datos del Prestatario y Producto
                </h5>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Cliente / Prestatario *</label>
                    <select name="client_id" id="client_id" class="form-select" required>
                        <option value="">-- Seleccionar cliente registrado --</option>
                        {% for c in clients %}
                        <option value="{{ c.id }}" {{ client_id == c.id ? 'selected' : '' }}>
                            {{ c.name }} {{ c.lastname }} (Doc: {{ c.document ?: 'S/D' }} - Tel: {{ c.phone ?: 'S/T' }})
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Línea de Crédito / Producto *</label>
                    <select name="loan_product_id" id="loan_product_sel" class="form-select" required onchange="onSelectProduct(this)">
                        <option value="">-- Seleccionar producto base --</option>
                        {% for p in loan_products %}
                        <option value="{{ p.id }}" data-rate="{{ p.interest_rate }}" data-freq="{{ p.frequency }}" data-min-term="{{ p.min_term }}" data-max-term="{{ p.max_term }}">
                            {{ p.name }} ({{ p.interest_rate }}% - {{ p.frequency == 1 ? 'Diario' : (p.frequency == 2 ? 'Semanal' : (p.frequency == 3 ? 'Quincenal' : 'Mensual')) }})
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">Asignar a Asesor / Agente (Usuario) *</label>
                    <select name="user_id" id="loan_user_id" class="form-select" required>
                        {% for u in users %}
                        <option value="{{ u.id }}" {{ curr_user.id == u.id ? 'selected' : '' }}>
                            {{ u.name }} {{ u.lastname }} ({{ u.rol ? u.rol.name : 'Usuario' }} - @{{ u.username }})
                        </option>
                        {% endfor %}
                    </select>
                    <div class="form-text small text-muted">El crédito quedará asignado a este asesor en su cartera.</div>
                </div>

                <h5 class="fw-bold text-indigo-900 mt-3 mb-3 pb-2 border-bottom d-flex align-items-center">
                    <i class="bi bi-cash-stack text-indigo-600 me-2"></i> Condiciones Financieras
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Monto Capital ({{ currency }}) *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">{{ currency }}</span>
                            <input type="number" step="0.01" min="1" name="amount" id="loan_amount" class="form-control fw-bold" placeholder="5000.00" value="5000.00" required oninput="calculateAmortization()">
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Tasa de Interés (%) *</label>
                        <div class="input-group">
                            <input type="number" step="0.01" min="0" name="interest_rate" id="loan_interest_rate" class="form-control" placeholder="5.00" value="5.00" required oninput="calculateAmortization()">
                            <span class="input-group-text bg-light">%</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Frecuencia de Pago *</label>
                        <select name="frequency" id="loan_frequency" class="form-select" required onchange="calculateAmortization()">
                            <option value="1">Diario</option>
                            <option value="2" selected>Semanal</option>
                            <option value="3">Quincenal</option>
                            <option value="4">Mensual</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold" id="label_term">Número de Cuotas / Semanas *</label>
                        <input type="number" min="1" max="150" name="term" id="loan_term" class="form-control fw-bold" value="8" required oninput="calculateAmortization()">
                    </div>

                    <!-- Botones de selección rápida de semanas -->
                    <div class="col-12">
                        <label class="form-label small text-muted d-block mb-1">Atajos rápidos de semanas:</label>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="setWeeks(4)">4 Semanas</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="setWeeks(8)">8 Semanas</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="setWeeks(12)">12 Semanas</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="setWeeks(16)">16 Semanas</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1" onclick="setWeeks(24)">24 Semanas</button>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Fecha de Desembolso *</label>
                        <input type="date" name="disbursement_date" id="disbursement_date" class="form-control" required value="{{ 'now'|date('Y-m-d') }}">
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Fecha Primer Pago *</label>
                        <input type="date" name="start_date" id="start_date" class="form-control" required value="{{ 'now'|date('Y-m-d') }}" onchange="calculateAmortization()">
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold">Observaciones / Notas</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Garantía prendaria, aval, observaciones del crédito..."></textarea>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-indigo text-white fw-bold px-4 py-2 flex-grow-1 shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Crear y Autorizar Préstamo
                    </button>
                    <a href="{{ base_url }}/loans" class="btn btn-light fw-bold px-3 py-2">
                        Cancelar
                    </a>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Tarjetas de Resumen y Agenda Simulada -->
        <div class="col-lg-7">
            <!-- Widgets de Resumen Financiero -->
            <div class="row g-3 mb-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 bg-white text-center">
                        <span class="text-muted small fw-bold d-block">CAPITAL SOLICITADO</span>
                        <h4 class="fw-bold text-dark mb-0 mt-1" id="kpi_capital">{{ currency }}5,000.00</h4>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 bg-white text-center">
                        <span class="text-muted small fw-bold d-block">INTERÉS TOTAL</span>
                        <h4 class="fw-bold text-amber-700 mb-0 mt-1" id="kpi_interes">{{ currency }}2,000.00</h4>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 bg-white text-center">
                        <span class="text-muted small fw-bold d-block">TOTAL A PAGAR</span>
                        <h4 class="fw-bold text-indigo-600 mb-0 mt-1" id="kpi_total">{{ currency }}7,000.00</h4>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3 bg-indigo-50 border border-indigo-100 text-center">
                        <span class="text-indigo-700 small fw-bold d-block">MONTO POR CUOTA</span>
                        <h4 class="fw-bold text-emerald-700 mb-0 mt-1" id="kpi_cuota">{{ currency }}875.00</h4>
                    </div>
                </div>
            </div>

            <!-- Tabla de Simulación de Agenda de Pagos -->
            <div class="card border-0 shadow-sm p-4">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                    <div>
                        <h5 class="fw-bold text-indigo-900 mb-0 d-flex align-items-center">
                            <i class="bi bi-calendar3-range text-indigo-600 me-2"></i> Agenda Simulada de Pagos
                        </h5>
                        <small class="text-muted" id="schedule_subtitle">Calculado para 8 cuotas semanales</small>
                    </div>
                    <span class="badge bg-light text-dark border px-2 py-1 small">
                        Término estimado: <strong id="schedule_end_date">--/--/----</strong>
                    </span>
                </div>

                <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0" id="schedule_table">
                        <thead class="table-light sticky-top">
                            <tr class="small text-muted text-uppercase">
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>Fecha Vencimiento</th>
                                <th class="text-end">Abono Capital</th>
                                <th class="text-end">Interés</th>
                                <th class="text-end fw-bold text-dark">Monto Cuota</th>
                                <th class="text-end">Saldo Restante</th>
                            </tr>
                        </thead>
                        <tbody id="schedule_tbody" class="small">
                            <!-- Las cuotas se generan dinámicamente con JavaScript -->
                        </tbody>
                        <tfoot class="table-light fw-bold small">
                            <tr>
                                <td colspan="2" class="text-center">TOTALES ESTIMADOS:</td>
                                <td class="text-end" id="tot_capital">{{ currency }}0.00</td>
                                <td class="text-end text-amber-700" id="tot_interes">{{ currency }}0.00</td>
                                <td class="text-end text-indigo-700" id="tot_cuota">{{ currency }}0.00</td>
                                <td class="text-end text-muted">-</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</form>
{% endblock %}

{% block scripts %}
<script>
const CURRENCY = "{{ currency }}";

function onSelectProduct(sel) {
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.dataset.rate) return;

    if (opt.dataset.rate) {
        document.getElementById('loan_interest_rate').value = parseFloat(opt.dataset.rate).toFixed(2);
    }
    if (opt.dataset.freq) {
        document.getElementById('loan_frequency').value = opt.dataset.freq;
    }
    if (opt.dataset.minTerm) {
        document.getElementById('loan_term').value = opt.dataset.minTerm;
    }
    calculateAmortization();
}

function setWeeks(num) {
    document.getElementById('loan_frequency').value = '2'; // Semanal
    document.getElementById('loan_term').value = num;
    calculateAmortization();
}

function formatMoney(amount) {
    return CURRENCY + Number(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function calculateAmortization() {
    const amount = parseFloat(document.getElementById('loan_amount').value) || 0;
    const rate = parseFloat(document.getElementById('loan_interest_rate').value) || 0;
    const term = parseInt(document.getElementById('loan_term').value) || 1;
    const frequency = parseInt(document.getElementById('loan_frequency').value) || 2;
    const startDateVal = document.getElementById('start_date').value || new Date().toISOString().slice(0, 10);

    // Ajustar etiqueta de cuotas
    const freqLabels = { 1: 'días', 2: 'semanas', 3: 'quincenas', 4: 'meses' };
    const freqSingular = { 1: 'Diario', 2: 'Semanal', 3: 'Quincenal', 4: 'Mensual' };
    document.getElementById('label_term').textContent = 'Número de Cuotas / ' + (freqLabels[frequency] || 'cuotas') + ' *';
    document.getElementById('schedule_subtitle').textContent = 'Calculado para ' + term + ' cuotas (' + freqSingular[frequency] + ')';

    // Fórmulas estándar de AtomCredit (Flat rate por período)
    const rateDecimal = rate / 100.0;
    const totalInterest = Math.round(amount * rateDecimal * term * 100) / 100;
    const totalAmount = Math.round((amount + totalInterest) * 100) / 100;
    const installmentAmount = Math.round((totalAmount / term) * 100) / 100;

    const principalPer = Math.round((amount / term) * 100) / 100;
    const interestPer = Math.round((totalInterest / term) * 100) / 100;

    // Actualizar Widgets superiores
    document.getElementById('kpi_capital').textContent = formatMoney(amount);
    document.getElementById('kpi_interes').textContent = formatMoney(totalInterest);
    document.getElementById('kpi_total').textContent = formatMoney(totalAmount);
    document.getElementById('kpi_cuota').textContent = formatMoney(installmentAmount);

    document.getElementById('tot_capital').textContent = formatMoney(amount);
    document.getElementById('tot_interes').textContent = formatMoney(totalInterest);
    document.getElementById('tot_cuota').textContent = formatMoney(totalAmount);

    // Construcción de la tabla de amortización simulada
    const tbody = document.getElementById('schedule_tbody');
    tbody.innerHTML = '';

    let balance = totalAmount;
    let currentDate = new Date(startDateVal + 'T12:00:00');

    let sumCap = 0;
    let sumInt = 0;
    let sumTot = 0;

    for (let i = 1; i <= term; i++) {
        // En la última cuota ajustamos centavos residuales
        let curPrincipal = (i === term) ? Math.round((amount - sumCap) * 100) / 100 : principalPer;
        let curInterest  = (i === term) ? Math.round((totalInterest - sumInt) * 100) / 100 : interestPer;
        let curTotal     = Math.round((curPrincipal + curInterest) * 100) / 100;

        sumCap += curPrincipal;
        sumInt += curInterest;
        sumTot += curTotal;

        balance = Math.max(0, Math.round((balance - curTotal) * 100) / 100);

        // Formato fecha
        const dateStr = currentDate.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });

        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center fw-bold text-muted">${i}</td>
            <td><i class="bi bi-calendar-event text-indigo-400 me-1"></i>${dateStr}</td>
            <td class="text-end">${formatMoney(curPrincipal)}</td>
            <td class="text-end text-amber-700">${formatMoney(curInterest)}</td>
            <td class="text-end fw-bold text-indigo-700">${formatMoney(curTotal)}</td>
            <td class="text-end text-muted">${formatMoney(balance)}</td>
        `;
        tbody.appendChild(tr);

        // Incrementar fecha según frecuencia
        if (i < term) {
            switch (frequency) {
                case 1: currentDate.setDate(currentDate.getDate() + 1); break;
                case 2: currentDate.setDate(currentDate.getDate() + 7); break;
                case 3: currentDate.setDate(currentDate.getDate() + 15); break;
                case 4: currentDate.setMonth(currentDate.getMonth() + 1); break;
            }
        }
    }

    const finalDateStr = currentDate.toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
    document.getElementById('schedule_end_date').textContent = finalDateStr;
}

// Inicializar simulación al cargar la página
document.addEventListener('DOMContentLoaded', function() {
    calculateAmortization();

    // Confirmación con SweetAlert2 al enviar
    $('#loan-origination-form').on('submit', function(e) {
        e.preventDefault();
        const clientText = $('#client_id option:selected').text();
        const total = $('#kpi_total').text();
        const cuota = $('#kpi_cuota').text();

        Swal.fire({
            title: '¿Confirmar Préstamo?',
            html: `Se registrará y activará el crédito por un total de <strong>${total}</strong> con cuotas de <strong>${cuota}</strong>.`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#6366f1',
            cancelButtonColor: '#94a3b8',
            confirmButtonText: 'Sí, crear préstamo',
            cancelButtonText: 'Revisar'
        }).then((result) => {
            if (result.isConfirmed) {
                this.submit();
            }
        });
    });
});
</script>
{% endblock %}
