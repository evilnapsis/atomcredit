{% extends "layouts/main.html.twig" %}

{% set active_menu = (status_filter == 'overdue') ? 'payments_overdue' : ((status_filter == 'paid') ? 'loans_paid' : 'loans') %}

{% block title %}{% if status_filter == 'paid' %}Préstamos Finalizados{% elseif status_filter == 'active' %}Préstamos Activos{% else %}Préstamos{% endif %} - AtomCredit{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <div class="d-flex align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">
                    {% if client %}
                        Préstamos de {{ client.name }} {{ client.lastname }}
                    {% elseif status_filter == 'paid' %}
                        Préstamos Finalizados
                    {% elseif status_filter == 'active' %}
                        Préstamos Activos
                    {% else %}
                        Préstamos
                    {% endif %}
                </h1>
            </div>
            <div class="ms-auto d-flex gap-2">
                {% if client_filter > 0 %}
                <a href="{{ base_url }}/loans" class="btn btn-light fw-bold"><i class="bi bi-arrow-left me-1"></i> Todos</a>
                {% endif %}
                <a href="{{ base_url }}/loans/new" class="btn btn-indigo shadow-sm fw-bold text-white px-4">
                    <i class="bi bi-plus-lg me-1"></i> Nuevo Préstamo
                </a>
            </div>
        </div>

        <!-- Filtros de estado -->
        {% if not client_filter %}
        <div class="mb-3 d-flex gap-2 flex-wrap">
            {% set statuses = {'active': 'Activos', 'all': 'Todos', 'overdue': 'En Mora', 'paid': 'Pagados', 'pending': 'Pendientes', 'cancelled': 'Cancelados'} %}
            {% for k, v in statuses %}
            <a href="{{ base_url }}/loans?status={{ k }}" class="btn btn-sm fw-bold {{ (status_filter == k) ? 'btn-indigo text-white' : 'btn-light' }}">
                {{ v }}
            </a>
            {% endfor %}
        </div>
        {% endif %}

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 datatable">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-4">#</th>
                                <th>Cliente</th>
                                <th>Producto</th>
                                <th>Monto</th>
                                <th>Cuota</th>
                                <th>Plazo</th>
                                <th>Inicio</th>
                                <th>Estado</th>
                                <th class="pe-4 text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for l in loans %}
                            <tr>
                                <td class="ps-4 text-muted small">{{ l.id }}</td>
                                <td>
                                    <div class="fw-bold small">{{ l.client_name }} {{ l.client_lastname }}</div>
                                </td>
                                <td class="small text-muted">{{ l.product_name }}</td>
                                <td>
                                    <div class="fw-bold">{{ currency }}{{ l.amount|number_format(2) }}</div>
                                    <div class="small text-muted">Total: {{ currency }}{{ l.total_amount|number_format(2) }}</div>
                                </td>
                                <td class="fw-bold text-indigo-600">{{ currency }}{{ l.installment_amount|number_format(2) }}</td>
                                <td class="small">
                                    {{ l.term }} cuotas 
                                    <span class="text-muted">
                                        ({{ l.frequency == 1 ? 'Diario' : (l.frequency == 2 ? 'Semanal' : (l.frequency == 3 ? 'Quincenal' : 'Mensual')) }})
                                    </span>
                                </td>
                                <td class="small text-muted">{{ l.start_date }}</td>
                                <td>
                                    <span class="badge {{ l.status == 'active' ? 'bg-success' : (l.status == 'overdue' ? 'bg-danger' : (l.status == 'paid' ? 'bg-primary' : 'bg-warning text-dark')) }}">
                                        {{ l.status == 'active' ? 'Activo' : (l.status == 'overdue' ? 'En Mora' : (l.status == 'paid' ? 'Pagado' : (l.status == 'cancelled' ? 'Cancelado' : 'Pendiente'))) }}
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="{{ base_url }}/loans/{{ l.id }}/pdf" target="_blank" class="btn btn-light btn-sm text-danger" title="Descargar PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                                    <a href="{{ base_url }}/loans/{{ l.id }}" class="btn btn-light btn-sm text-primary" title="Ver detalle"><i class="bi bi-eye"></i></a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nuevo Préstamo -->
<div class="modal fade" id="newLoanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius:20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Nuevo Préstamo</h5>
                <button type="button" class="btn-close" data-coreui-dismiss="modal"></button>
            </div>
            <form id="add-loan-form">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Cliente *</label>
                            <select name="client_id" class="form-select" required>
                                <option value="">-- Seleccionar cliente --</option>
                                {% for c in clients %}
                                <option value="{{ c.id }}" {{ (client_filter == c.id) ? 'selected' : '' }}>
                                    {{ c.name }} {{ c.lastname }} ({{ c.document }})
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Producto *</label>
                            <select name="loan_product_id" id="loan_product_sel" class="form-select" required onchange="loadProduct(this.value)">
                                <option value="">-- Seleccionar producto --</option>
                                {% for p in loan_products %}
                                <option value="{{ p.id }}" data-rate="{{ p.interest_rate }}" data-freq="{{ p.frequency }}">
                                    {{ p.name }} ({{ p.interest_rate }}% - {{ p.frequency == 1 ? 'Diario' : (p.frequency == 2 ? 'Semanal' : (p.frequency == 3 ? 'Quincenal' : 'Mensual')) }})
                                </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Tasa de Interés (%) *</label>
                            <input type="number" step="0.01" name="interest_rate" id="loan_interest_rate" class="form-control" required oninput="previewCalc()">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Frecuencia *</label>
                            <select name="frequency" id="loan_frequency" class="form-select" required>
                                <option value="1">Diario</option>
                                <option value="2">Semanal</option>
                                <option value="3">Quincenal</option>
                                <option value="4" selected>Mensual</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Monto a Prestar *</label>
                            <input type="number" step="0.01" name="amount" id="loan_amount" class="form-control" required oninput="previewCalc()">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Número de Cuotas *</label>
                            <input type="number" name="term" id="loan_term" class="form-control" required oninput="previewCalc()">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold d-block">&nbsp;</label>
                            <div class="p-2 bg-indigo-50 rounded text-center small">
                                Cuota estimada: <strong id="preview_installment">{{ currency }}0.00</strong><br>
                                Total: <strong id="preview_total">{{ currency }}0.00</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Fecha de Desembolso *</label>
                            <input type="date" name="disbursement_date" class="form-control" required value="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Fecha Primer Pago *</label>
                            <input type="date" name="start_date" class="form-control" required value="{{ 'now'|date('Y-m-d') }}">
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold">Notas</label>
                            <textarea name="notes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light fw-bold" data-coreui-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-indigo text-white fw-bold px-4">Crear Préstamo</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
function loadProduct(id){
    const sel = document.getElementById('loan_product_sel');
    const opt = sel.options[sel.selectedIndex];
    if(opt && opt.dataset.rate){
        document.getElementById('loan_interest_rate').value = opt.dataset.rate;
        document.getElementById('loan_frequency').value = opt.dataset.freq || '4';
        previewCalc();
    }
}

function previewCalc(){
    const amount = parseFloat(document.getElementById('loan_amount').value) || 0;
    const rate = parseFloat(document.getElementById('loan_interest_rate').value) || 0;
    const term = parseInt(document.getElementById('loan_term').value) || 0;
    if(amount > 0 && term > 0){
        const total_interest = amount * (rate/100) * term;
        const total = amount + total_interest;
        const installment = total / term;
        document.getElementById('preview_installment').textContent = '{{ currency }}' + installment.toFixed(2);
        document.getElementById('preview_total').textContent = '{{ currency }}' + total.toFixed(2);
    }
}

document.getElementById('add-loan-form').onsubmit = function(e){
    e.preventDefault();
    const formData = new FormData(this);
    fetch('{{ base_url }}/loans/create', { 
        method: 'POST', 
        body: formData,
        headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.json())
    .then(res => {
        if(res.success){
            Swal.fire({ 
                icon: 'success', 
                title: '¡Préstamo creado!', 
                text: 'El plan de cuotas fue generado.', 
                timer: 2000, 
                showConfirmButton: false 
            }).then(() => { 
                window.location.href = '{{ base_url }}/loans/' + res.id; 
            });
        } else {
            Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'No se pudo crear el préstamo.' });
        }
    })
    .catch(() => {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un problema de comunicación.' });
    });
};
</script>
{% endblock %}
