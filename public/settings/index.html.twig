{% extends "layouts/main.html.twig" %}

{% block title %}Configuración del Sistema - AtomCredit{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-12">
        <div class="d-flex align-items-center mb-4">
            <div>
                <h1 class="h3 fw-bold mb-0">Configuración General</h1>
                <p class="text-muted small mb-0">Administre la información del negocio y moneda del sistema</p>
            </div>
        </div>

        <div class="row">
            <div class="col-md-8 col-lg-7">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Información de la Empresa</h5>
                        <form method="post" action="{{ base_url }}/settings/general">
                            {{ csrf_field() }}
                            <div class="mb-3">
                                <label class="form-label fw-bold small">Nombre de la Empresa *</label>
                                <input type="text" name="company_name" class="form-control" value="{{ settings.company_name }}" required>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Email de Contacto</label>
                                    <input type="email" name="company_email" class="form-control" value="{{ settings.company_email }}">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Teléfono</label>
                                    <input type="text" name="company_phone" class="form-control" value="{{ settings.company_phone }}">
                                </div>
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-bold small">Moneda (Símbolo)</label>
                                <input type="text" name="currency" class="form-control" style="width:120px;" value="{{ settings.currency }}" placeholder="Q">
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-indigo text-white fw-bold px-4">
                                    <i class="bi bi-save me-1"></i> Guardar Cambios
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
