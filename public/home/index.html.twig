{% extends "layouts/main.html.twig" %}

{% set active_menu = 'home' %}

{% block title %}Panel de Control - AtomCredit{% endblock %}

{% block content %}
<div class="row mb-3">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm text-white py-3 px-4" style="background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%); border-radius: 14px;">
            <div class="d-flex align-items-center">
                <div class="bg-white bg-opacity-15 text-white me-3 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width:42px;height:42px;">
                    <i class="bi bi-lightning-charge-fill fs-5 text-warning"></i>
                </div>
                <div>
                    <h1 class="h5 fw-bold mb-0">Panel de Control <span class="text-white-50">AtomCredit</span></h1>
                </div>
                <div class="ms-auto d-none d-md-block">
                    <div class="bg-white bg-opacity-10 px-3 py-1 rounded-pill small">
                        <span class="fw-semibold"><i class="bi bi-calendar3 me-2"></i>{{ "now"|date("d M, Y") }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPIs con Color Sólido -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-white h-100" style="background: #2563eb; border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white text-opacity-75 text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Préstamos Activos</div>
                    <div class="h2 fw-bold mb-0 text-white mt-1">{{ active_loans|length }}</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 ms-2 shadow-sm"
                     style="width: 56px; height: 56px; background: rgba(255, 255, 255, 0.22); border: 1px solid rgba(255, 255, 255, 0.35);">
                    <i class="bi bi-cash-stack" style="font-size: 28px; line-height: 1; color: #ffffff !important;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-white h-100" style="background: #059669; border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white text-opacity-75 text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Clientes</div>
                    <div class="h2 fw-bold mb-0 text-white mt-1">{{ clients|length }}</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 ms-2 shadow-sm"
                     style="width: 56px; height: 56px; background: rgba(255, 255, 255, 0.22); border: 1px solid rgba(255, 255, 255, 0.35);">
                    <i class="bi bi-people-fill" style="font-size: 28px; line-height: 1; color: #ffffff !important;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-white h-100" style="background: #dc2626; border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white text-opacity-75 text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">En Mora</div>
                    <div class="h2 fw-bold mb-0 text-white mt-1">{{ total_overdue }}</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 ms-2 shadow-sm"
                     style="width: 56px; height: 56px; background: rgba(255, 255, 255, 0.22); border: 1px solid rgba(255, 255, 255, 0.35);">
                    <i class="bi bi-exclamation-octagon-fill" style="font-size: 28px; line-height: 1; color: #ffffff !important;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm text-white h-100" style="background: #d97706; border-radius: 16px;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-white text-opacity-75 text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Capital Activo</div>
                    <div class="h2 fw-bold mb-0 text-white mt-1">{{ currency }}{{ total_capital|number_format(2) }}</div>
                </div>
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0 ms-2 shadow-sm"
                     style="width: 56px; height: 56px; background: rgba(255, 255, 255, 0.22); border: 1px solid rgba(255, 255, 255, 0.35);">
                    <i class="bi bi-bank2" style="font-size: 28px; line-height: 1; color: #ffffff !important;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Gráfica de Pagos Recibidos de los Últimos 30 Días -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 p-4 d-flex align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">Cobranza y Pagos Recibidos (Últimos 30 Días)</h5>
                    <small class="text-muted">Evolución diaria de los pagos recibidos en el sistema</small>
                </div>
                <div class="ms-auto">
                    <span class="badge bg-indigo text-white fs-6 px-3 py-2 fw-bold">
                        <i class="bi bi-cash-stack me-1"></i> Total: {{ currency }}{{ daily_payments.total|number_format(2) }}
                    </span>
                </div>
            </div>
            <div class="card-body p-4 pt-0">
                <div style="height: 280px; position: relative;">
                    <canvas id="dailyPaymentsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Préstamos recientes -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-bottom-0 p-4 d-flex align-items-center">
                <h5 class="fw-bold mb-0">Préstamos Recientes</h5>
                <a href="{{ base_url }}/loans" class="ms-auto btn btn-light btn-sm fw-bold">Ver todos</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="bg-light text-muted">
                            <tr>
                                <th class="ps-4">Cliente</th>
                                <th>Monto</th>
                                <th>Cuota</th>
                                <th>Inicio</th>
                                <th class="pe-4">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for l in recent_loans %}
                            <tr>
                                <td class="ps-4 fw-bold">
                                    <a href="{{ base_url }}/loans/{{ l.id }}" class="text-decoration-none text-dark">
                                        {{ l.client_name }} {{ l.client_lastname }}
                                    </a>
                                </td>
                                <td>{{ currency }}{{ l.amount|number_format(2) }}</td>
                                <td class="text-indigo-600 fw-bold">{{ currency }}{{ l.installment_amount|number_format(2) }}</td>
                                <td class="text-muted">{{ l.start_date }}</td>
                                <td class="pe-4">
                                    <span class="badge {{ l.status == 'active' ? 'bg-success' : (l.status == 'overdue' ? 'bg-danger' : (l.status == 'paid' ? 'bg-primary' : 'bg-warning text-dark')) }}">
                                        {{ l.status == 'active' ? 'Activo' : (l.status == 'overdue' ? 'En Mora' : (l.status == 'paid' ? 'Pagado' : 'Pendiente')) }}
                                    </span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">No hay préstamos registrados</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen de Cartera -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100" style="background:#eff6ff;">
            <div class="card-header bg-transparent border-0 p-4">
                <h5 class="fw-bold mb-0">Resumen de Cartera</h5>
            </div>
            <div class="card-body p-4 pt-0">
                {% for st, info in statuses %}
                <div class="mb-3">
                    <div class="d-flex justify-content-between small mb-1">
                        <span class="fw-bold">{{ info.label }}</span>
                        <span>{{ info.count }} ({{ info.pct }}%)</span>
                    </div>
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar" style="width:{{ info.pct }}%;background:{{ info.color }};"></div>
                    </div>
                </div>
                {% endfor %}

                <div class="mt-4 pt-3 border-top">
                    <a href="{{ base_url }}/loans" class="btn btn-indigo text-white w-100 fw-bold">
                        <i class="bi bi-arrow-right-circle me-1"></i> Administrar Préstamos
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('dailyPaymentsChart');
    if (!ctx) return;

    const labels = {{ daily_payments.labels|json_encode|raw }};
    const values = {{ daily_payments.data|json_encode|raw }};

    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [{
                label: 'Cobranza ({{ currency }})',
                data: values,
                fill: true,
                backgroundColor: 'rgba(99, 102, 241, 0.12)',
                borderColor: '#6366f1',
                borderWidth: 2.5,
                tension: 0.35,
                pointBackgroundColor: '#6366f1',
                pointBorderColor: '#ffffff',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return ' Cobrado: {{ currency }}' + Number(context.parsed.y).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    }
                }
            },
            scales: {
                x: {
                    grid: {
                        display: false
                    },
                    ticks: {
                        maxRotation: 45,
                        minRotation: 0,
                        autoSkip: true,
                        maxTicksLimit: 15,
                        font: { size: 11 }
                    }
                },
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return '{{ currency }}' + Number(value).toLocaleString('es-MX');
                        },
                        font: { size: 11 }
                    },
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)'
                    }
                }
            }
        }
    });
});
</script>
{% endblock %}
